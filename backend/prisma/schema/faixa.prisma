model Faixa {
  id           Int      @id @default(autoincrement())
  obraId       Int      @map("obra_id")
  limiteMaximo Decimal? @map("limite_maximo") @db.Decimal(14, 2) // null = sem teto

  obra        Obra             @relation(fields: [obraId], references: [id])
  aprovadores AprovadorFaixa[]

  // NULL não é igual a NULL no Postgres, então esta unique aceita duas faixas sem teto na mesma obra.
  // Quem impede isso é o índice parcial "faixas_obra_sem_teto_key", criado à mão na migration init.
  @@unique([obraId, limiteMaximo])
  @@map("faixas")
}
