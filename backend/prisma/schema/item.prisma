model Item {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("pedido_id")
  descricao     String
  quantidade    Decimal @db.Decimal(12, 3) // aceita 2,5 kg
  unidade       Unidade
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(14, 2)
  total         Decimal @db.Decimal(14, 2) // quantidade × preço, arredondado

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("itens")
}
