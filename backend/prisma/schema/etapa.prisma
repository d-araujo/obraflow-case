// Snapshot da cadeia no momento da criação do pedido: depois disso não consulta mais as faixas,
// então editar regras não muda pedidos existentes. As etapas em ordem são também o histórico.
model Etapa {
  id          Int         @id @default(autoincrement())
  pedidoId    Int         @map("pedido_id")
  ordem       Int
  aprovadorId Int         @map("aprovador_id")
  status      StatusEtapa @default(PENDENTE)
  motivo      String? // obrigatório na rejeição, validado no service
  decididaEm  DateTime?   @map("decidida_em")

  pedido    Pedido  @relation(fields: [pedidoId], references: [id])
  aprovador Usuario @relation(fields: [aprovadorId], references: [id])

  @@unique([pedidoId, ordem])
  @@index([aprovadorId, status])
  @@map("etapas")
}
