enum StatusPedido {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("status_pedido")
}

// Não existe "AGUARDANDO": qual etapa pendente é a da vez quem diz é Pedido.etapaAtual.
// Guardar isso aqui também seria duplicar informação.
enum StatusEtapa {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA // etapas que nem chegaram a acontecer porque alguém antes rejeitou

  @@map("status_etapa")
}

enum Unidade {
  UN
  KG
  M
  M2 // enum não aceita "m²"; o front mostra o rótulo bonito
  H

  @@map("unidade")
}
