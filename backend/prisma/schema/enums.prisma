enum StatusPedido {
  PENDENTE
  APROVADO
  REJEITADO

  @@map("status_pedido")
}

// Sem "AGUARDANDO": a etapa da vez é a de ordem = Pedido.etapaAtual. Guardar aqui duplicaria a informação.
enum StatusEtapa {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA // etapa que não chegou a acontecer porque uma anterior rejeitou

  @@map("status_etapa")
}

enum Unidade {
  UN
  KG
  M
  M2 // enum não aceita "m²"; o rótulo fica no front
  M3
  H

  @@map("unidade")
}
