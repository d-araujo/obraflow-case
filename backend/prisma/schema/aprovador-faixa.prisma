model AprovadorFaixa {
  id        Int @id @default(autoincrement())
  faixaId   Int @map("faixa_id")
  usuarioId Int @map("usuario_id")
  ordem     Int

  faixa   Faixa   @relation(fields: [faixaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([faixaId, ordem])
  @@unique([faixaId, usuarioId])
  @@index([usuarioId])
  @@map("aprovadores_faixa")
}
